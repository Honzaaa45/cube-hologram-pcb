# ---------------------------------------------------------------------------
# CUBE - variables d'environnement optionnelles
#
# Ce projet ne manipule AUCUN secret : pas de cle d'API, pas de token, pas de
# base de donnees. Les deux variables ci-dessous servent uniquement a passer
# outre la detection automatique de KiCad (tools/kicadpath.py), par exemple si
# vous avez plusieurs versions installees ou une installation portable.
#
# Elles se lisent dans l'environnement du shell : ce fichier documente, il
# n'est pas charge automatiquement.
#
#   Windows PowerShell : $env:KICAD_SHARE = "D:\KiCad\9.0\share\kicad"
#   bash / zsh         : export KICAD_SHARE=/usr/share/kicad
# ---------------------------------------------------------------------------

# Dossier de donnees KiCad 9 : celui qui contient symbols/ et footprints/.
# Laisse vide = detection automatique.
KICAD_SHARE=

# Chemin complet de l'executable kicad-cli.
# Laisse vide = recherche dans le PATH, puis dans les emplacements habituels.
KICAD_CLI=
